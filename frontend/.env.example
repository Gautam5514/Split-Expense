# ------------------------------------------------------------------
# Frontend environment variables — SAMPLE FILE
# ------------------------------------------------------------------
# Copy this file to ".env.local" (or ".env") and fill in your values:
#     cp .env.example .env.local
#
# NEVER commit your real env file. It is already ignored by git.
# NOTE: NEXT_PUBLIC_* values are exposed to the browser by design —
# only put values here that are safe to be public.
# ------------------------------------------------------------------

# URL of the backend API (see backend/.env -> PORT)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web config (from Firebase console -> Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key
